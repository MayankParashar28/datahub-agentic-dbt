      "nullable": false,
      "is_primary_key": false,
      "tags": ["commerce"],
      "glossary_terms": ["Product"]
    },
    {
      "name": "subcategory",
      "data_type": "VARCHAR",
      "description": "Detailed merchandise subcategory classification.",
      "nullable": true,
      "is_primary_key": false,
      "tags": ["commerce"],
      "glossary_terms": []
    },
    {
      "name": "brand",
      "data_type": "VARCHAR",
      "description": "Manufacturer or brand label name.",
      "nullable": true,
      "is_primary_key": false,
      "tags": ["commerce"],
      "glossary_terms": ["Product"]
    },
    {
